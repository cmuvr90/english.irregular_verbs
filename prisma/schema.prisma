// Схема Prisma. Модели User/Session/Account/Verification — служебные таблицы
// Better Auth, их структура должна совпадать с core-схемой библиотеки.
// При обновлении better-auth сверяйтесь с `npx @better-auth/cli generate`.
//
// Все даты объявлены как @db.Timestamptz — Postgres хранит их с таймзоной,
// поэтому момент времени не «едет» при смене TZ процесса (локально CEST, Vercel UTC).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("student")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres не индексирует внешние ключи автоматически: без этого выборка
  // сессий пользователя деградирует в seq scan по мере роста таблицы.
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Хеш пароля для входа по email+password (providerId = "credential").
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Составной: Better Auth ищет запись по userId + providerId на каждом входе.
  @@index([userId, providerId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// Неправильный глагол: три формы и переводы по локалям.
/// translation — json вида {"en": "...", "be": "...", "uk": "...", ...},
/// ключи совпадают с локалями из src/lib/locales.ts.
model Verb {
  id          String   @id @default(cuid())
  form1       String   @map("form_1")
  form2       String   @map("form_2")
  form3       String   @map("form_3")
  translation Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  groups VerbGroupLink[]

  @@map("verbs")
}

/// Группа глаголов (например, «самые частые», «формы совпадают»).
/// name и description — json с переводами, как translation у Verb.
model VerbGroup {
  id          String   @id @default(cuid())
  /// Машинный ключ группы: стабильный идентификатор для кода и сидов.
  key         String   @unique
  name        Json
  description Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")

  verbs VerbGroupLink[]

  @@map("verb_groups")
}

/// Связь «многие-ко-многим»: один глагол может входить в несколько групп.
model VerbGroupLink {
  verbId      String @map("verb_id")
  verbGroupId String @map("verb_group_id")

  verb  Verb      @relation(fields: [verbId], references: [id], onDelete: Cascade)
  group VerbGroup @relation(fields: [verbGroupId], references: [id], onDelete: Cascade)

  @@id([verbId, verbGroupId])
  // Составной PK покрывает поиск по verb_id; для выборки глаголов группы нужен свой индекс.
  @@index([verbGroupId])
  @@map("verb_group_links")
}
