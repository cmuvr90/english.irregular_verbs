# --- База данных ---
# Локально: Postgres из docker-compose.yml
# На Vercel: строка подключения от Prisma Postgres (ставит интеграция, нужен ?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/app"

# --- Better Auth ---
# Секрет для подписи сессий и шифрования токенов.
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Базовый URL приложения.
# Локально ОСТАВЬТЕ ПУСТЫМ/ЗАКОММЕНТИРОВАННЫМ: тогда Better Auth возьмёт адрес
# из самого запроса и всё работает на любом порту (3000, 3001, ...).
# Если задать здесь localhost:3000, а dev-сервер поднимется на 3001 —
# будет ошибка "Invalid origin".
# На Vercel: боевой домен, напр. https://myapp.vercel.app
# BETTER_AUTH_URL="https://myapp.vercel.app"